{
  "name": "@church/database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "dotenv -e ../.env -- prisma generate",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../.env -- ts-node --transpile-only prisma/seed.ts",
    "studio": "dotenv -e ../.env -- prisma studio"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
