# Committed on purpose — NEXT_PUBLIC_* values are public (embedded in the
# client bundle) and not secrets. Next.js loads this automatically for any
# production build (`next build` / `next start`, including on Vercel), so
# deploys always target the production API without relying on a Vercel
# dashboard setting being present.
NEXT_PUBLIC_API_URL="https://jeapmethodistapi.vercel.app/api/v1"
