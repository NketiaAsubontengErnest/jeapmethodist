# =============================================================================
# Church Management System — Environment Variables
# Copy this file to .env and fill in real values. Never commit the real .env.
# =============================================================================

# --- Database (PostgreSQL via Prisma) ---
# Local development (Docker Postgres started with `npm run docker:up`)
DATABASE_URL="postgresql://church_admin:church_dev_password@localhost:5433/church_management?schema=public"
# For providers that require a separate non-pooled connection for migrations
# (e.g. Neon, Supabase). Defaults to DATABASE_URL if not set.
DIRECT_URL="postgresql://church_admin:church_dev_password@localhost:5433/church_management?schema=public"

# --- Auth / JWT ---
JWT_SECRET="change-me-dev-only-access-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- API server ---
API_PORT=4000
API_PREFIX="api/v1"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3001"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# --- File storage ---
# STORAGE_PROVIDER options: local | s3 | cloudinary | vercel-blob | supabase
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# --- Email (future integration) ---
# EMAIL_PROVIDER options: none | resend | sendgrid | smtp
EMAIL_PROVIDER="none"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@example.org"

# --- Ghana / locale defaults ---
DEFAULT_CURRENCY="GHS"
DEFAULT_TIMEZONE="Africa/Accra"
